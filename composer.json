    "description": "Self-hosted, privacy-friendly ALTCHA (proof-of-work CAPTCHA) integration for Mautic forms.",
    "type": "mautic-plugin",
    "license": "GPL-3.0-only",
    "authors": [{
        "name": "Tuomas Välimaa"
    }],
    "keywords": [
        "mautic",
        "plugin",
        "integration",
        "altcha",
        "captcha",
        "proof-of-work",
        "spam-protection"
    ],
    "require": {
        "php": "^8.1|^8.2",
        "ext-json": "*",
        "mautic/core-lib": "^5.0|^6.0|^7.0",
        "altcha-org/altcha": "^2.0"
    },
    "extra": {
        "install-directory-name": "MauticAltchaBundle"
    }
